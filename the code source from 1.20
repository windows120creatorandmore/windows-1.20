$OutputEncoding = [System.Text.Encoding]::UTF8
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
# WIN 1.20 - Terminal OS (Login, Settings, Recovery, Password Fix)
$storageDir = Join-Path $PSScriptRoot "Win120_Data"
$setupFile = Join-Path $storageDir "system.cfg"
if (!(Test-Path $storageDir)) { New-Item -ItemType Directory -Path $storageDir | Out-Null }

# FIXED: Helper function that works on ALL computers in 2026
function Get-PasswordHash($password) {
    $ptr = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($password)
    try {
        $plainText = [System.Runtime.InteropServices.Marshal]::PtrToStringBSTR($ptr)
        $bytes = [System.Text.Encoding]::UTF8.GetBytes($plainText)
        $hash = [System.Security.Cryptography.SHA256]::Create().ComputeHash($bytes)
        return [System.BitConverter]::ToString($hash) -replace "-"
    } finally {
        [System.Runtime.InteropServices.Marshal]::ZeroFreeBSTR($ptr)
    }
}

# 1. SETUP SEQUENCE (Runs only if system.cfg is missing)
if (!(Test-Path $setupFile)) {
    Clear-Host; Write-Host "WIN 1.20 INSTALLATION" -ForegroundColor Cyan
    $userName = Read-Host "Enter a Username for this PC"
    $pcColor = Read-Host "Choose System Color (Cyan, Green, Yellow, White)"
    $setPass = Read-Host "Do you want to set a password? (Y/N)"

    $passwordHash = $null
    if ($setPass -eq 'Y') {
        $password = Read-Host "Enter password" -AsSecureString
        $passwordHash = Get-PasswordHash $password
    }
    
    $setupData = @{ User = $userName; Color = $pcColor; PassHash = $passwordHash }
    $setupData | ConvertTo-Json | Out-File $setupFile
    Write-Host "`nSetup Complete! Restarting to Win 1.20..." -ForegroundColor Green
    Start-Sleep -Seconds 2
}

# Load user settings
$settings = Get-Content $setupFile | ConvertFrom-Json
$firstBoot = $true
$running = $true
$menuOptions = "Notepad", "Settings", "Exit to Windows"
$selected = 0

# 2. LOGIN SCREEN (Runs every time the OS starts)
if ($settings.PassHash) {
    while ($true) {
        Clear-Host; Write-Host "WIN 1.20 LOGIN" -ForegroundColor $settings.Color
        Write-Host "Welcome, $($settings.User)."
        Write-Host "Type 'RESET' if you forgot your password." -ForegroundColor Yellow
        
        $inputCommand = Read-Host "Type a command or just press Enter to login"

        if ($inputCommand -eq 'RESET') {
            $confirmReset = Read-Host "Are you sure you want to clear password? (Y/N)"
            if ($confirmReset -eq 'Y') {
                $settings.PassHash = $null 
                $settings | ConvertTo-Json | Out-File $setupFile
                Write-Host "`nPassword cleared. Please login without a password now." -ForegroundColor Green
                Start-Sleep -Seconds 2
                break
            }
        }
        
        $inputPassSecure = Read-Host "Enter your password" -AsSecureString
        $inputHash = Get-PasswordHash $inputPassSecure
        
        if ($inputHash -eq $settings.PassHash) {
            Write-Host "`nLogin successful!" -ForegroundColor Green; Start-Sleep -Seconds 1; break
        } else {
            Write-Host "`nIncorrect password. Try again." -ForegroundColor Red; Start-Sleep -Seconds 1
        }
    }
}

# 3. SETTINGS APP
function Show-Settings {
    while ($true) {
        Clear-Host; Write-Host "--- WIN 1.20 SETTINGS ---" -ForegroundColor $settings.Color
        Write-Host "1: Personalize System Color"
        Write-Host "2: System Specifications"
        Write-Host "3: Reinstall/Reset OS"
        Write-Host "4: Set or Change Password"
        Write-Host "0: Back to Main Menu"
        $choice = Read-Host "`nSelect an option"
        
        switch ($choice) {
            '1' { $newColor = Read-Host "New Color (Cyan, Green, Yellow, White)"; $settings.Color = $newColor; $settings | ConvertTo-Json | Out-File $setupFile; Write-Host "Color updated! Restart OS to fully apply."; Start-Sleep -Seconds 2 }
            '2' { Clear-Host; Write-Host "OS Version: 1.20 (2026)"; Write-Host "User: $($settings.User)"; Write-Host "Host OS: Windows 11 Terminal"; Read-Host "Press Enter" }
            '3' { $confirm = Read-Host "WARNING: This will delete all settings and force a reinstall on next boot. Continue? (Y/N)"; if ($confirm -eq 'Y') { Remove-Item $setupFile -Force; Write-Host "Settings deleted. Please exit and relaunch Win 1.20 to reinstall." -ForegroundColor Red; Read-Host "Press Enter to exit the current session."; $global:running = $false; return } }
            '4' { $password = Read-Host "Enter new password (leave blank for no password)" -AsSecureString; $settings.PassHash = Get-PasswordHash $password; $settings | ConvertTo-Json | Out-File $setupFile; Write-Host "Password updated!" -ForegroundColor Green; Start-Sleep -Seconds 1 }
            '0' { return }
        }
    }
}

# 4. NOTEPAD APP 
function Show-Notepad {
    $subRunning = $true
    while ($subRunning) {
        Clear-Host
        $files = Get-ChildItem -Path $storageDir -Filter "*.txt"
        Write-Host "--- WIN 1.20 NOTEPAD ---" -ForegroundColor $settings.Color
        for ($i = 0; $i -lt $files.Count; $i++) { Write-Host "[$($i + 1)] $($files[$i].BaseName)" -ForegroundColor Cyan }
        $newIndex = $files.Count + 1
        Write-Host "[$newIndex] (Create New Text)" -ForegroundColor Green
        Write-Host " [0] Back to Menu"
        $choice = Read-Host "`nSelect an option"
        if ($choice -eq "0") { $subRunning = $false }
        elseif ($choice -eq $newIndex) {
            $name = Read-Host "Filename"; $content = Read-Host "Content"
            $content | Out-File -FilePath (Join-Path $storageDir "$name.txt")
        }
        elseif ($choice -match '^\d+$' -and $choice -le $files.Count) {
            Clear-Host; Get-Content $files[$choice-1].FullName; Read-Host "`n[Press Enter]"
        }
    }
}

# 5. MAIN OS LOOP
while ($running) {
    if ($firstBoot) {
        Clear-Host
        Write-Host @"
  ██╗    ██╗██╗███╗   ██╗     ██╗    ██████╗  ██████╗ 
  ██║    ██║██║████╗  ██║    ███║    ╚════██╗██╔═████╗
  ██║ █╗ ██║██║██╔██╗ ██║    ╚██║     █████╔╝██║██╔██║
  ██║███╗██║██║██║╚██╗██║     ██║    ██╔═══╝ ████╔╝██║
  ╚███╔███╔╝██║██║ ╚████║     ██║    ███████╗╚██████╔╝
   ╚══╝╚══╝ ╚═╝╚═╝  ╚═══╝     ╚═╝    ╚══════╝ ╚═════╝ 
"@ -ForegroundColor $settings.Color
        Write-Host "       WELCOME, $($settings.User.ToUpper())" -ForegroundColor White
        Write-Host "       VERSION 1.20 | 2026 RELEASE`n" -ForegroundColor Gray
        Start-Sleep -Seconds 1
        $firstBoot = $false
    }

    Clear-Host
    Write-Host "==============================" -ForegroundColor $settings.Color
    Write-Host "       WIN 1.20 MAIN MENU     " -ForegroundColor White
    Write-Host "==============================" -ForegroundColor $settings.Color
    for ($i = 0; $i -lt $menuOptions.Count; $i++) {
        if ($i -eq $selected) {
            Write-Host " > [ $($menuOptions[$i]) ] " -ForegroundColor Black -BackgroundColor White
        } else {
            Write-Host "   $($menuOptions[$i])  " -ForegroundColor Gray
        }
    }

    $key = $Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
    switch ($key.VirtualKeyCode) {
        38 { $selected = ($selected - 1 + $menuOptions.Count) % $menuOptions.Count }
        40 { $selected = ($selected + 1) % $menuOptions.Count }
        13 { 
            if ($menuOptions[$selected] -eq "Notepad") { Show-Notepad }
            if ($menuOptions[$selected] -eq "Settings") { Show-Settings }
            if ($menuOptions[$selected] -eq "Exit to Windows") { $running = $false }
        }
    }
}

Read-Host "`nSystem exited. Press Enter to close window"
